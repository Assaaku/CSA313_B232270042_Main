    ];

    n32b -> n33 [
        label="T\nbonusNegativeThresholdThrows"
    ];

    n32b -> n35 [
        label="F\nbonusEmptyThresholdZeroGetsFive"
    ];

    n35 -> n36 [
        label="bonusEmptyThresholdZeroGetsFive"
    ];

    n36 -> n37 [
        label="bonusEmptyThresholdZeroGetsFive"
    ];

    n37 -> n38c [
        label="bonusEmptyThresholdZeroGetsFive"
    ];

    n38c -> n38d [
        label="T\nallDefsLongStreak"
    ];

    n38c -> n49 [
        label="F\nbonusEmptyThresholdZeroGetsFive"
    ];

    n38d -> n39 [
