{
  "info": {
    "name": "Lab05 API System Test",
    "description": "F.CSA313 Lab 05 - Postman and Newman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 - Happy Path",
      "item": [
        {
          "name": "Setup active student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/students/L5_HAPPY",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Setup course requiring CS201",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/courses/L5_HAPPY_COURSE",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register successfully",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"L5_HAPPY\",\n  \"courseID\": \"L5_HAPPY_COURSE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Result is OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
